<Project Sdk="Uno.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0-windows10.0.26100;net10.0-browserwasm;net10.0-desktop</TargetFrameworks>

    <OutputType>Exe</OutputType>
    <UnoSingleProject>true</UnoSingleProject>

    <!-- Display name -->
    <ApplicationTitle>ImageViewerUno</ApplicationTitle>
    <!-- App Identifier -->
    <ApplicationId>com.unoplatform.imageviewer</ApplicationId>
    <!-- Versions -->
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <!-- Package Publisher -->
    <ApplicationPublisher>ImageViewerUno</ApplicationPublisher>
    <!-- Package Description -->
    <Description>ImageViewerUno powered by Uno Platform.</Description>
    <!--
      If you encounter this error message:

        error NETSDK1148: A referenced assembly was compiled using a newer version of Microsoft.Windows.SDK.NET.dll.
        Please update to a newer .NET SDK in order to reference this assembly.

      This means that the two packages below must be aligned with the "build" version number of
      the "Microsoft.Windows.SDK.BuildTools" package above, and the "revision" version number
      must be the highest found in https://www.nuget.org/packages/Microsoft.Windows.SDK.NET.Ref.
    -->
    <!-- <WindowsSdkPackageVersion>10.0.22621.28</WindowsSdkPackageVersion> -->

    <!--
      UnoFeatures are used to quickly add and manage features enabled for your app.
      https://aka.platform.uno/singleproject-features
    -->
    <!-- NETSDK1198: 'win-AnyCPU.pubxml' is a phantom publish profile inferred by Microsoft.NET.Publish.targets when no PublishProfile is set. Cosmetic only. -->
    <NoWarn>$(NoWarn);NETSDK1198</NoWarn>

    <UnoFeatures>
      Material;
      Dsp;
      Hosting;
      Toolkit;
      Logging;
      MVUX;
      Configuration;
      HttpKiota;
      Serialization;
      Localization;
      ThemeService;
      SkiaRenderer;
    </UnoFeatures>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SixLabors.ImageSharp" />
    <!-- Explicit transitive upgrade to clear NU1903 (see Directory.Packages.props). -->
    <PackageReference Include="System.Security.Cryptography.Xml" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Tmds.DBus.Protocol is a transitive dep of the Skia Desktop stack (needed for Linux).
      Advisory GHSA-xrw6-gwf8-vvr9 is not fixed in any published version as of 2026-04-17;
      suppress the targeted advisory rather than broad NU1903 to keep other vuln warnings visible.
      Re-evaluate when the upstream fix ships.
    -->
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-xrw6-gwf8-vvr9" />
  </ItemGroup>

</Project>
