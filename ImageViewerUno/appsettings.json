{
  "AppConfig": {
    "Environment": "Production"
  },
  "ApiClient": {
    "UseNativeHandler": true
  },
  "LocalizationConfiguration": {
    "Cultures": [ "es", "fr", "pt-BR", "en" ]
  },
  "ImageViewerSettings": {
    "ApplicationTitle": "Uno Image Viewer",
    "BackgroundColor": "Black",
    "CloseOnLostFocus": false,
    "ImageDurationSeconds": 2,
    "IncludedFileExtensions": ".bmp,.gif,.jpeg,.jpg,.png,.tif,.tiff,.webp",
    "MsgColor": "LimeGreen",
    "MsgFadeoutSeconds": 2.0,
    "RunAnimatedGifs": true,
    "ShowHelpOnLoad": false,
    "ZoomMax": 5.0,
    "ZoomMin": 0.1,
    "ZoomStep": 1.25
  }
}
